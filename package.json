{
  "name": "mesh-integration-tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cross-package integration tests for the BrowserMesh ecosystem",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "serve:notes": "npx serve examples/example-p2p-notes -l 3001",
    "serve:chat": "npx serve examples/example-decentralized-chat -l 3002",
    "serve:lobby": "npx serve examples/example-game-lobby -l 3003",
    "serve:sandbox": "npx serve examples/example-code-sandbox -l 3004",
    "serve:all": "npx concurrently \"npm:serve:notes\" \"npm:serve:chat\" \"npm:serve:lobby\" \"npm:serve:sandbox\""
  },
  "dependencies": {
    "browsermesh-primitives": "^0.1.1",
    "browsermesh-netway": "^0.1.1",
    "browsermesh-pod": "^0.2.0",
    "wsh-upon-star": "^0.1.1",
    "andbox": "^0.1.1",
    "ai-matey-middleware-andbox": "^0.1.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
